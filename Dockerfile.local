# ===============================
# LOCAL DEVELOPMENT DOCKERFILE
# ===============================
# This image is intentionally developer-friendly:
# - Includes app source mounted from host (see compose/run instructions).
# - Runs uvicorn with --reload for rapid local iteration.
# - Keeps dependencies installed in the container for consistency.

FROM python:3.11-slim

# ===============================
# SYSTEM SETUP
# ===============================
# We install only minimal tools required for psycopg2 compilation/runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# ===============================
# APPLICATION WORKDIR
# ===============================
WORKDIR /app

# ===============================
# PYTHON DEPENDENCIES
# ===============================
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# ===============================
# SOURCE CODE
# ===============================
# For local testing you can either bake source into image (this COPY) OR
# mount source as a bind volume when running docker.
COPY . /app

# ===============================
# RUNTIME
# ===============================
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
